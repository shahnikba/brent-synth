# Data — never commit
data/
*.csv
*.parquet

# Generated reports ARE committed so the README links resolve on a fresh
# clone. The per-(model, origin) backtest cache is not: it is 1.6 MB of
# regenerable derived data, keyed by the pre-registration hash.
reports/backtest_cache/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Environments
.venv/

# macOS
.DS_Store
